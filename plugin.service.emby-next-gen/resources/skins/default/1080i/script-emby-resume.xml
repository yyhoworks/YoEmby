<?xml version="1.0" encoding="UTF-8"?>
<!-- [CE-OPT] Plan A neutral obsidian resume dialog (480px width, high-contrast focus, noop horizontal nav) -->
<window id="3301" type="dialog">
	<defaultcontrol always="true">100</defaultcontrol>
	<controls>
		<control type="group">
			<control type="image">
				<top>0</top>
				<bottom>0</bottom>
				<left>0</left>
				<right>0</right>
				<texture colordiffuse="CC000000">white.png</texture>
				<aspectratio>stretch</aspectratio>
				<animation effect="fade" end="100" time="180">WindowOpen</animation>
				<animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
			</control>
			<control type="group">
				<animation effect="slide" time="0" end="0,-15" condition="true">Conditional</animation>
				<animation type="WindowOpen" reversible="false">
					<effect type="zoom" start="88" end="100" center="960,540" delay="100" tween="circle" easing="out" time="220" />
					<effect type="fade" delay="100" end="100" time="220" />
				</animation>
				<animation type="WindowClose" reversible="false">
					<effect type="zoom" start="100" end="88" center="960,540" tween="circle" easing="in" time="180" />
					<effect type="fade" start="100" end="0" time="180" />
				</animation>
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>480</width>
				<height>90%</height>
				<control type="grouplist" id="100">
					<orientation>vertical</orientation>
					<left>0</left>
					<right>0</right>
					<height>auto</height>
					<align>center</align>
					<itemgap>0</itemgap>
					<onright>noop</onright>
					<onleft>noop</onleft>
					<usecontrolcoords>true</usecontrolcoords>
					<control type="group">
						<height>32</height>
						<control type="image">
							<left>20</left>
							<width>100%</width>
							<height>25</height>
							<texture>logo-white.png</texture>
							<aspectratio align="left">keep</aspectratio>
						</control>
						<control type="image">
							<right>20</right>
							<width>100%</width>
							<height>25</height>
							<aspectratio align="right">keep</aspectratio>
							<texture diffuse="user_image.png">$INFO[Window(Home).Property(EmbyUserImage)]</texture>
							<visible>!String.IsEmpty(Window(Home).Property(EmbyUserImage))</visible>
						</control>
						<control type="image">
							<right>20</right>
							<width>100%</width>
							<height>25</height>
							<aspectratio align="right">keep</aspectratio>
							<texture diffuse="user_image.png">userflyoutdefault.png</texture>
							<visible>String.IsEmpty(Window(Home).Property(EmbyUserImage))</visible>
						</control>
					</control>
					<control type="image">
						<width>100%</width>
						<height>12</height>
						<texture border="5" colordiffuse="F2181C24">dialogs/menu_top.png</texture>
					</control>
					<control type="button" id="3010">
						<width>100%</width>
						<height>68</height>
						<align>left</align>
						<aligny>center</aligny>
						<textoffsetx>24</textoffsetx>
						<font>font13</font>
						<textcolor>FFE2E8F0</textcolor>
						<focusedcolor>FF12161F</focusedcolor>
						<disabledcolor>FF505868</disabledcolor>
						<texturefocus border="10" colordiffuse="FFF1F3F5">dialogs/menu_back.png</texturefocus>
						<texturenofocus border="10" colordiffuse="F2181C24">dialogs/menu_back.png</texturenofocus>
						<alttexturefocus border="10" colordiffuse="FFF1F3F5">dialogs/menu_back.png</alttexturefocus>
						<alttexturenofocus border="10" colordiffuse="F2181C24">dialogs/menu_back.png</alttexturenofocus>
					</control>
					<control type="button" id="3011">
						<width>100%</width>
						<height>68</height>
						<align>left</align>
						<aligny>center</aligny>
						<textoffsetx>24</textoffsetx>
						<font>font13</font>
						<textcolor>FFE2E8F0</textcolor>
						<focusedcolor>FF12161F</focusedcolor>
						<disabledcolor>FF505868</disabledcolor>
						<texturefocus border="10" colordiffuse="FFF1F3F5">dialogs/menu_back.png</texturefocus>
						<texturenofocus border="10" colordiffuse="F2181C24">dialogs/menu_back.png</texturenofocus>
						<alttexturefocus border="10" colordiffuse="FFF1F3F5">dialogs/menu_back.png</alttexturefocus>
						<alttexturenofocus border="10" colordiffuse="F2181C24">dialogs/menu_back.png</alttexturenofocus>
					</control>
					<control type="image">
						<width>100%</width>
						<height>12</height>
						<texture border="5" colordiffuse="F2181C24">dialogs/menu_bottom.png</texture>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
