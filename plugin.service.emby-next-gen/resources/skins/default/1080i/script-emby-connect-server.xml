<?xml version='1.0' encoding='UTF-8'?>
<!-- [CE-OPT] Plan A neutral obsidian server selector (fixes stray &gt;, horizontal close & easin typo) -->
<window>
    <defaultcontrol always="true">205</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="zoom" start="88" end="100" center="960,540" delay="100" tween="circle" easing="out" time="220" />
        <effect type="fade" delay="100" end="100" time="220" />
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="zoom" start="100" end="88" center="960,540" tween="circle" easing="in" time="180" />
        <effect type="fade" start="100" end="0" time="180" />
    </animation>
    <controls>
        <control type="group">
            <control type="image">
                <top>-200</top>
                <bottom>-200</bottom>
                <left>-200</left>
                <right>-200</right>
                <texture colordiffuse="CC000000">white.png</texture>
                <aspectratio>stretch</aspectratio>
                <animation effect="fade" end="100" time="180">WindowOpen</animation>
                <animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
            </control>
            <control type="group">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>560</width>
                <height>540</height>
                <control type="group">
                    <top>-32</top>
                    <control type="image">
                        <left>20</left>
                        <width>100%</width>
                        <height>25</height>
                        <texture>logo-white.png</texture>
                        <aspectratio align="left">keep</aspectratio>
                    </control>
                    <control type="image" id="150">
                        <right>20</right>
                        <width>100%</width>
                        <height>25</height>
                        <aspectratio align="right">keep</aspectratio>
                        <texture diffuse="user_image.png">userflyoutdefault.png</texture>
                    </control>
                </control>
                <control type="image">
                    <width>100%</width>
                    <height>540</height>
                    <texture colordiffuse="F2181C24" border="10">dialogs/dialog_back.png</texture>
                </control>
                <control type="group">
                    <centerleft>50%</centerleft>
                    <top>12</top>
                    <width>536</width>
                    <height>516</height>
                    <control type="grouplist" id="100">
                        <orientation>vertical</orientation>
                        <itemgap>0</itemgap>
                        <control type="label">
                            <width>100%</width>
                            <height>72</height>
                            <aligny>center</aligny>
                            <textoffsetx>22</textoffsetx>
                            <font>font13</font>
                            <textcolor>FFF5F5F7</textcolor>
                            <label>[B]$ADDON[plugin.service.emby-next-gen 30607][/B]</label>
                        </control>
                        <control type="group" id="101">
                            <height>204</height>
                            <control type="list" id="155">
                                <centerleft>50%</centerleft>
                                <width>516</width>
                                <height>198</height>
                                <onup>noop</onup>
                                <onleft>noop</onleft>
                                <onright>noop</onright>
                                <ondown>205</ondown>
                                <itemlayout width="516" height="66">
                                    <control type="image">
                                        <left>4</left>
                                        <top>3</top>
                                        <width>508</width>
                                        <height>60</height>
                                        <texture colordiffuse="12FFFFFF">white.png</texture>
                                    </control>
                                    <control type="group">
                                        <left>22</left>
                                        <top>13</top>
                                        <width>36</width>
                                        <height>40</height>
                                        <control type="image">
                                            <aspectratio>keep</aspectratio>
                                            <texture colordiffuse="FFB8C0CC">network.png</texture>
                                            <visible>String.IsEqual(ListItem.Property(server_type),network)</visible>
                                        </control>
                                        <control type="image">
                                            <aspectratio>keep</aspectratio>
                                            <texture colordiffuse="FFB8C0CC">wifi.png</texture>
                                            <visible>String.IsEqual(ListItem.Property(server_type),wifi)</visible>
                                        </control>
                                    </control>
                                    <control type="label">
                                        <left>62</left>
                                        <width>438</width>
                                        <height>66</height>
                                        <aligny>center</aligny>
