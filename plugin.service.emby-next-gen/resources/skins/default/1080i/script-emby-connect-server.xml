                                            <description>Network</description>
                                            <aspectratio>keep</aspectratio>
                                            <texture colordiffuse="FF12161F">network.png</texture>
                                            <visible>String.IsEqual(ListItem.Property(server_type),network) + Control.HasFocus(155)</visible>
                                        </control>
                                        <control type="image">
                                            <description>Network unfocused</description>
                                            <aspectratio>keep</aspectratio>
                                            <texture colordiffuse="FFB8C0CC">network.png</texture>
                                            <visible>String.IsEqual(ListItem.Property(server_type),network) + !Control.HasFocus(155)</visible>
                                        </control>
                                        <control type="image">
                                            <description>Wifi</description>
                                            <aspectratio>keep</aspectratio>
                                            <texture colordiffuse="FF12161F">wifi.png</texture>
                                            <visible>String.IsEqual(ListItem.Property(server_type),wifi) + Control.HasFocus(155)</visible>
                                        </control>
                                        <control type="image">
                                            <description>Wifi unfocused</description>
                                            <aspectratio>keep</aspectratio>
                                            <texture colordiffuse="FFB8C0CC">wifi.png</texture>
                                            <visible>String.IsEqual(ListItem.Property(server_type),wifi) + !Control.HasFocus(155)</visible>
                                        </control>
                                    </control>
                                    <control type="label">
                                        <left>62</left>
                                        <width>438</width>
                                        <height>66</height>
                                        <aligny>center</aligny>
                                        <textoffsetx>12</textoffsetx>
                                        <font>font13</font>
                                        <scroll>true</scroll>
                                        <textcolor>FF12161F</textcolor>
                                        <label>$INFO[ListItem.Label]</label>
                                        <visible>Control.HasFocus(155)</visible>
                                    </control>
                                    <control type="label">
                                        <left>62</left>
                                        <width>438</width>
                                        <height>66</height>
                                        <aligny>center</aligny>
                                        <textoffsetx>12</textoffsetx>
                                        <font>font13</font>
                                        <textcolor>FFE2E8F0</textcolor>
                                        <label>$INFO[ListItem.Label]</label>
                                        <visible>!Control.HasFocus(155)</visible>
                                    </control>
                                </focusedlayout>
                            </control>
                            <control type="image" id="204">
