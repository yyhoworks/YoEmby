                                        <textcolor>FFE2E8F0</textcolor>
                                        <label>$INFO[ListItem.Label]</label>
                                    </control>
                                </itemlayout>
                                <focusedlayout width="516" height="66">
                                    <control type="image">
                                        <left>4</left>
                                        <top>3</top>
                                        <width>508</width>
                                        <height>60</height>
                                        <texture colordiffuse="18FFFFFF">white.png</texture>
                                        <visible>!Control.HasFocus(155)</visible>
                                    </control>
                                    <control type="image">
                                        <left>4</left>
                                        <top>3</top>
                                        <width>508</width>
                                        <height>60</height>
                                        <texture colordiffuse="FFF1F3F5">white.png</texture>
                                        <visible>Control.HasFocus(155)</visible>
                                    </control>
                                    <control type="group">
                                        <left>22</left>
                                        <top>13</top>
                                        <width>36</width>
                                        <height>40</height>
