                                <align>center</align>
                                <width>120</width>
                                <height>200</height>
                                <visible>false</visible>
                                <texture colordiffuse="FFE2E8F0">spinner.gif</texture>
                                <aspectratio>keep</aspectratio>
                            </control>
                        </control>
                        <control type="label" id="102">
                            <description>spacer</description>
                            <height>18</height>
                        </control>
                        <control type="button" id="205">
                            <label>[B]$ADDON[plugin.service.emby-next-gen 30600][/B]</label>
