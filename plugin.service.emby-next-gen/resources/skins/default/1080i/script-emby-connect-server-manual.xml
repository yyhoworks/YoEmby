<?xml version='1.0' encoding='UTF-8'?>
<!-- [CE-OPT] Plan A neutral obsidian manual server dialog (preserves 470x470 ControlEdit coordinates) -->
<window>
    <defaultcontrol always="true">200</defaultcontrol>
    <animation type="WindowOpen" reversible="false">
        <effect type="zoom" start="88" end="100" center="960,540" delay="100" tween="circle" easing="out" time="220" />
        <effect type="fade" delay="100" end="100" time="220" />
    </animation>
    <animation type="WindowClose" reversible="false">
        <effect type="zoom" start="100" end="88" center="960,540" tween="circle" easing="in" time="180" />
        <effect type="fade" start="100" end="0" time="180" />
    </animation>
    <controls>
        <control type="group">
            <control type="image">
                <top>-200</top>
                <bottom>-200</bottom>
                <left>-200</left>
                <right>-200</right>
                <texture colordiffuse="CC000000">white.png</texture>
                <aspectratio>stretch</aspectratio>
                <animation effect="fade" end="100" time="180">WindowOpen</animation>
                <animation effect="fade" start="100" end="0" time="180">WindowClose</animation>
            </control>
            <control type="group">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>470</width>
                <height>470</height>
                <control type="group">
                    <top>-30</top>
                    <control type="image">
                        <left>20</left>
                        <width>100%</width>
                        <height>25</height>
                        <texture>logo-white.png</texture>
                        <aspectratio align="left">keep</aspectratio>
                    </control>
                </control>
                <control type="image">
                    <width>100%</width>
                    <height>470</height>
                    <texture colordiffuse="F2181C24" border="10">dialogs/dialog_back.png</texture>
                </control>
                <control type="group">
                    <centerleft>50%</centerleft>
                    <top>10</top>
                    <width>460</width>
                    <height>470</height>
                    <control type="grouplist" id="100">
                        <orientation>vertical</orientation>
                        <itemgap>0</itemgap>
                        <control type="label">
                            <width>100%</width>
                            <height>75</height>
                            <aligny>center</aligny>
                            <textoffsetx>20</textoffsetx>
                            <font>font13</font>
                            <textcolor>FFF5F5F7</textcolor>
                            <label>[B]$ADDON[plugin.service.emby-next-gen 30614][/B]</label>
                        </control>
                        <control type="group" id="101">
                            <height>110</height>
                            <control type="label">
                                <label>$ADDON[plugin.service.emby-next-gen 30615]</label>
                                <textcolor>FFB0B8C4</textcolor>
                                <font>font12</font>
                                <aligny>top</aligny>
                                <textoffsetx>20</textoffsetx>
                            </control>
                            <control type="image">
                                <left>20</left>
                                <top>40</top>
                                <width>420</width>
                                <height>48</height>
                                <texture colordiffuse="18FFFFFF">white.png</texture>
                            </control>
                            <control type="image">
                                <left>20</left>
                                <right>20</right>
                                <height>1</height>
                                <top>90</top>
                                <texture colordiffuse="38FFFFFF">white.png</texture>
                            </control>
                        </control>
                        <control type="group" id="102">
                            <height>110</height>
                            <control type="label">
                                <label>$ADDON[plugin.service.emby-next-gen 30030]</label>
                                <textcolor>FFB0B8C4</textcolor>
                                <font>font12</font>
                                <aligny>top</aligny>
                                <textoffsetx>20</textoffsetx>
                            </control>
                            <control type="image">
