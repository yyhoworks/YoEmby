                            <textoffsetx>20</textoffsetx>
                            <aligny>center</aligny>
                            <align>center</align>
                            <texturefocus border="10" colordiffuse="FFFFFFFF">buttons/shadow_smallbutton.png</texturefocus>
                            <texturenofocus border="10" colordiffuse="24FFFFFF">buttons/shadow_smallbutton.png</texturenofocus>
                            <pulseonselect>no</pulseonselect>
